# Supabase Postgres — use the Transaction pooler connection string (port 6543), with the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Anthropic API key (message drafting only)
ANTHROPIC_API_KEY=
# Fast, low-cost Claude model for drafting
LLM_MODEL=claude-haiku-5-5
# Protects Reset demo / re-seed (required once the demo has data)
SETUP_TOKEN=
